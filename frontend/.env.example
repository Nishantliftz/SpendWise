# =============================================================
#  SpendWise Frontend – Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# =============================================================

# Backend API base URL (used when NOT using the Vite proxy, e.g. in production)
VITE_API_BASE_URL=http://localhost:8080/api

# App title (optional override)
VITE_APP_NAME=SpendWise
